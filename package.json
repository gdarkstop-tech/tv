{
  "name": "nova-tv-os",
  "productName": "NOVA TV OS",
  "version": "0.1.0",
  "description": "NOVA TV OS — a premium smart-TV environment for a laptop driving a non-smart television over HDMI.",
  "private": true,
  "license": "MIT",
  "author": "NOVA TV OS contributors",
  "main": "dist/main/main.cjs",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:main": "node scripts/build-main.mjs",
    "build:renderer": "vite build --config vite.renderer.config.ts",
    "build:remote": "vite build --config vite.remote.config.ts",
    "build": "npm run build:main && npm run build:renderer && npm run build:remote",
    "start": "npm run build && electron .",
    "dev": "node scripts/dev.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "node scripts/run-e2e.mjs",
    "hardware-report": "npm run build:main && electron dist/main/hardware-report.cjs",
    "dist": "npm run build && electron-builder --publish never",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:linux": "npm run build && electron-builder --linux --publish never"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/noto-sans-arabic": "5.3.0",
    "lucide-react": "1.56.0",
    "qrcode": "1.5.4",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "ws": "8.22.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@noble/curves": "1.9.7",
    "@noble/hashes": "1.8.0",
    "@types/node": "22.20.5",
    "@types/qrcode": "1.5.5",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.9.3",
    "electron-builder": "26.18.1",
    "esbuild": "0.25.12",
    "playwright": "1.63.0",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  }
}
